<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bishe.system.mapper.ClubActivityMapper">

    <resultMap type="ClubActivity" id="ClubActivityResult">
        <result property="activityId"  column="activity_id" />
        <result property="clubId"      column="club_id" />
        <result property="title"       column="title" />
        <result property="content"     column="content" />
        <result property="location"    column="location" />
        <result property="startTime"   column="start_time" />
        <result property="endTime"     column="end_time" />
        <result property="capacity"    column="capacity" />
        <result property="status"      column="status" />
        <result property="auditUserId" column="audit_user_id" />
        <result property="auditTime"   column="audit_time" />
        <result property="auditRemark" column="audit_remark" />
        <result property="createBy"    column="create_by" />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by" />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark" />
    </resultMap>

    <sql id="selectClubActivityVo">
        select activity_id, club_id, title, content, location, start_time, end_time, capacity,
               status, audit_user_id, audit_time, audit_remark,
               create_by, create_time, update_by, update_time, remark
        from club_activity
    </sql>

    <select id="selectClubActivityById" parameterType="Long" resultMap="ClubActivityResult">
        <include refid="selectClubActivityVo"/>
        where activity_id = #{activityId}
    </select>

    <select id="selectClubActivityList" parameterType="ClubActivity" resultMap="ClubActivityResult">
        <include refid="selectClubActivityVo"/>
        <where>
            <if test="clubId != null and clubId != 0">
                and club_id = #{clubId}
            </if>
            <if test="title != null and title != ''">
                and title like concat('%', #{title}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
    </select>

    <insert id="insertClubActivity" parameterType="ClubActivity">
        insert into club_activity(
            <if test="clubId != null">club_id,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="content != null">content,</if>
            <if test="location != null and location != ''">location,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="capacity != null">capacity,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="auditUserId != null">audit_user_id,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="auditRemark != null and auditRemark != ''">audit_remark,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        ) values (
            <if test="clubId != null">#{clubId},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null">#{content},</if>
            <if test="location != null and location != ''">#{location},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="capacity != null">#{capacity},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="auditUserId != null">#{auditUserId},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="auditRemark != null and auditRemark != ''">#{auditRemark},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateClubActivity" parameterType="ClubActivity">
        update club_activity
        <set>
            <if test="clubId != null">club_id = #{clubId},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="location != null">location = #{location},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="auditUserId != null">audit_user_id = #{auditUserId},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where activity_id = #{activityId}
    </update>

    <delete id="deleteClubActivityById" parameterType="Long">
        delete from club_activity where activity_id = #{activityId}
    </delete>

    <delete id="deleteClubActivityByIds" parameterType="Long">
        delete from club_activity where activity_id in
        <foreach item="activityId" collection="array" open="(" separator="," close=")">
            #{activityId}
        </foreach>
    </delete>

</mapper>

